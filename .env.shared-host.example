# نسخه مخصوص هاست اشتراکی DirectAdmin / cPanel / XAMPP — بدون Docker و بدون Redis
APP_NAME="سامانه پشتیبانی سورین"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://support.dpst.ir
APP_LOCALE=fa

COMPANY_NAME="شرکت دریاپردازشگران سورین طبرستان"
COMPANY_NAME_EN="Soorin Tabarestan"
COMPANY_WEBSITE=https://dpst.ir
COMPANY_FOUNDED_YEAR=1400

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=error

# --- ایمیل — اطلاعات SMTP هاست را اینجا وارد کنید ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@dpst.ir
MAIL_FROM_NAME="${APP_NAME}"

# به‌روزرسانیِ تک‌کلیکیِ بدونِ SSH (مثلِ وردپرس) — آدرسِ عمومیِ مانیفست (latest.json).
# با deploy/build-package.sh ساخته می‌شود. خالی = غیرفعال.
APP_UPDATE_MANIFEST=https://github.com/tv3irib3-cpu/Soorin_Support/releases/latest/download/latest.json
